{
    "devDependencies": {
        "cspell": "^10.2.1"
    },
    "scripts": {
        "check:spelling": "cspell check",
        "lint": "npm run lint:spelling",
        "lint:spelling": "git ls-files | cspell lint --file-list stdin --no-progress --relative --show-suggestions --show-context --no-must-find-files"
    }
}
