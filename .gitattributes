# Store and check out text files with LF line endings on every platform.
* text=auto eol=lf
# Leave npm's dev tooling out of the Composer package.
/package.json export-ignore
/package-lock.json export-ignore
/renovate.json export-ignore
# And the code quality config.
/.qlty export-ignore
# Leave the architecture decision records and agent instructions out too.
/docs export-ignore
/AGENTS.md export-ignore
